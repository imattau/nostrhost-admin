{
  "name": "nostrhost-admin",
  "version": "0.1.0",
  "private": true,
  "description": "NostrHost administration console",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint:js": "eslint src/App.vue src/main.ts src/router src/api/nativePackages.ts src/types/nostr.d.ts src/views/native src/components/ui src/components/layouts src/composables src/lib/utils.ts vite.config.ts",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:prettier",
    "lintfix": "prettier --write --list-different . && yarn lint:js --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "upgrade-deps": "yarn upgrade-interactive --latest"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.2",
    "vite": "^6.4.2",
    "vue-tsc": "2.1.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "bugs": {
    "url": "https://github.com/imattau/nostrhost-admin/issues"
  },
  "homepage": "https://github.com/imattau/nostrhost-admin",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/imattau/nostrhost-admin"
  }
}
